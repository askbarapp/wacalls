generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  AGENT
}

enum ChannelStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  ERROR
  RECONNECTING
}

enum CallStatus {
  QUEUED
  CONNECTING
  RINGING
  ANSWERED
  ENDED
  FAILED
  BUSY
  NO_ANSWER
  REJECTED
  CANCELLED
}

enum CallOutcome {
  ANSWERED
  NO_ANSWER
  BUSY
  REJECTED
  FAILED
  CALLBACK
  INTERESTED
  NOT_INTERESTED
  WRONG_NUMBER
  DO_NOT_CALL
}

enum AutoReplyTrigger {
  ANSWERED
  NO_ANSWER
  REJECTED
  NOT_CONNECTED
}

enum CampaignType {
  MANUAL
  SEQUENTIAL
  RECORDED
  TTS
  AI_VOICE
  MESSAGE
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum OrgStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum ChannelProvider {
  WEB
  CLOUD
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum AgentPresence {
  READY
  BUSY
  OFFLINE
}

enum RecordingAfterAction {
  HANGUP
  WAIT_FOR_RESPONSE
  TRANSFER_TO_AGENT
}

model Plan {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  description        String   @default("")
  maxChannels        Int      @default(1) @map("max_channels")
  maxAgents          Int      @default(3) @map("max_agents")
  maxKnowledgeBases  Int      @default(1) @map("max_knowledge_bases")
  maxAiAgents        Int      @default(1) @map("max_ai_agents")
  maxMessagesPerDay  Int      @default(200) @map("max_messages_per_day")
  maxCallsPerDay     Int      @default(50) @map("max_calls_per_day")
  allowCloudApi      Boolean  @default(false) @map("allow_cloud_api")
  allowSdk           Boolean  @default(true) @map("allow_sdk")
  priceMonthly       Int      @default(0) @map("price_monthly")
  isPublic           Boolean  @default(true) @map("is_public")
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organizations Organization[]

  @@map("plans")
}

model Organization {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  status       OrgStatus @default(TRIAL)
  planId       String?   @map("plan_id")
  billingEmail String?   @map("billing_email")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  plan             Plan?               @relation(fields: [planId], references: [id])
  users            OrganizationUser[]
  channels         WhatsAppChannel[]
  contacts         Contact[]
  contactLists     ContactList[]
  campaigns        Campaign[]
  calls            Call[]
  recordings       Recording[]
  voiceTemplates   VoiceTemplate[]
  messageTemplates MessageTemplate[]
  knowledgeBases   KnowledgeBase[]
  aiConfigs        AiConfig[]
  appointments     Appointment[]
  appointmentSlots AppointmentSlot[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  auditLogs        AuditLog[]
  settings         Setting[]
  passwordResets   PasswordReset[]
  invitations      Invitation[]
  callbackTasks    CallbackTask[]
  messages         Message[]
  visits              Visit[]
  visitLeads          VisitLead[]
  visitDepartments    VisitDepartment[]
  visitSessions       VisitSession[]
  visitPageViews      VisitPageView[]
  visitConversations  VisitConversation[]
  visitChatMessages   VisitChatMessage[]
  incomingAnswers     IncomingAnswerConfig[]
  autoReplyRules      AutoReplyRule[]
  contactMemories     ContactMemory[]
  intentEvents        IntentEvent[]

  @@index([planId])
  @@index([status])
  @@map("organizations")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String         @map("password_hash")
  name           String
  phone          String?
  avatarPath     String?        @map("avatar_path")
  isSuperAdmin   Boolean        @default(false) @map("is_super_admin")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  memberships    OrganizationUser[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  callsAsAgent   Call[]         @relation("CallAgent")

  @@index([email])
  @@map("users")
}

model OrganizationUser {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  userId         String        @map("user_id")
  role           Role
  presence       AgentPresence @default(OFFLINE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordReset {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  userId         String    @map("user_id")
  tokenHash      String    @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_resets")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  role           Role
  tokenHash      String    @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tokenHash])
  @@map("invitations")
}

model WhatsAppChannel {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  phoneNumber        String?         @map("phone_number")
  displayName        String          @map("display_name")
  status             ChannelStatus   @default(DISCONNECTED)
  sessionStatus      String          @default("DISCONNECTED") @map("session_status")
  callingEngine      String          @default("selfhosted") @map("calling_engine")
  provider           ChannelProvider @default(WEB)
  cloudPhoneNumberId String?         @map("cloud_phone_number_id")
  cloudAccessToken   String?         @map("cloud_access_token")
  lastConnectedAt    DateTime?       @map("last_connected_at")
  lastSeenAt         DateTime?       @map("last_seen_at")
  lastError          String?         @map("last_error")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session           WhatsAppSession?
  campaigns         Campaign[]
  campaignChannels  CampaignChannel[]
  calls             Call[]
  messages          Message[]
  appointments      Appointment[]
  visits             Visit[]
  visitDepartments   VisitDepartment[]
  visitConversations VisitConversation[]
  incomingAnswer     IncomingAnswerConfig?

  @@index([organizationId])
  @@index([status])
  @@map("whatsapp_channels")
}

model WhatsAppSession {
  id             String   @id @default(uuid())
  channelId      String   @unique @map("channel_id")
  organizationId String   @map("organization_id")
  storagePath    String   @map("storage_path")
  encryptedBlob  Bytes?   @map("encrypted_blob")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  channel WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("whatsapp_sessions")
}

model Contact {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  phone          String
  email          String?
  company        String?
  tags           String[]  @default([])
  customFields   Json      @default("{}") @map("custom_fields")
  notes          String?
  status         String    @default("active")
  doNotCall      Boolean   @default(false) @map("do_not_call")
  whatsappOn     Boolean?  @map("whatsapp_on")
  whatsappCheckedAt DateTime? @map("whatsapp_checked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listMembers      ContactListMember[]
  campaignContacts CampaignContact[]
  calls            Call[]
  messages         Message[]
  appointments     Appointment[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([phone])
  @@index([status])
  @@map("contacts")
}

model ContactList {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ContactListMember[]
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("contact_lists")
}

model ContactListMember {
  id            String   @id @default(uuid())
  contactListId String   @map("contact_list_id")
  contactId     String   @map("contact_id")
  createdAt     DateTime @default(now()) @map("created_at")

  list    ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactListId, contactId])
  @@index([contactId])
  @@map("contact_list_members")
}

model Campaign {
  id              String               @id @default(uuid())
  organizationId  String               @map("organization_id")
  channelId       String               @map("channel_id")
  contactListId   String?              @map("contact_list_id")
  name            String
  type            CampaignType         @default(SEQUENTIAL)
  status          CampaignStatus       @default(DRAFT)
  scheduleAt      DateTime?            @map("schedule_at")
  maxAttempts     Int                  @default(3) @map("max_attempts")
  retryDelayMin   Int                  @default(30) @map("retry_delay_min")
  callMode        String               @default("SEQUENTIAL") @map("call_mode")
  recordingId     String?              @map("recording_id")
  voiceTemplateId String?              @map("voice_template_id")
  aiConfigId      String?              @map("ai_config_id")
  afterRecording  RecordingAfterAction @default(HANGUP) @map("after_recording")
  messageBody     String?              @map("message_body")
  messageTemplateId String?            @map("message_template_id")
  rotationLimit   Int                  @default(0) @map("rotation_limit")
  delayBetweenCallsSec Int             @default(5) @map("delay_between_calls_sec")
  ringTimeoutSec  Int                  @default(60) @map("ring_timeout_sec")
  batchSize       Int                  @default(0) @map("batch_size")
  sleepAfterBatchSec Int               @default(0) @map("sleep_after_batch_sec")
  /// Optional AI talk limit for this campaign; null = use agent default.
  maxCallDurationSec Int?              @map("max_call_duration_sec")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel          WhatsAppChannel    @relation(fields: [channelId], references: [id])
  campaignChannels CampaignChannel[]
  contactList      ContactList?       @relation(fields: [contactListId], references: [id])
  recording        Recording?         @relation(fields: [recordingId], references: [id])
  voiceTemplate    VoiceTemplate?     @relation(fields: [voiceTemplateId], references: [id])
  messageTemplate  MessageTemplate?   @relation(fields: [messageTemplateId], references: [id])
  aiConfig         AiConfig?          @relation(fields: [aiConfigId], references: [id])
  campaignContacts CampaignContact[]
  calls            Call[]
  messages         Message[]
  autoReplyRules   AutoReplyRule[]

  @@index([organizationId])
  @@index([channelId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignChannel {
  id         String @id @default(uuid())
  campaignId String @map("campaign_id")
  channelId  String @map("channel_id")
  sortOrder  Int    @default(0) @map("sort_order")

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel  WhatsAppChannel @relation(fields: [channelId], references: [id])

  @@unique([campaignId, channelId])
  @@index([channelId])
  @@map("campaign_channels")
}

model CampaignContact {
  id             String      @id @default(uuid())
  campaignId     String      @map("campaign_id")
  contactId      String      @map("contact_id")
  status         String      @default("pending")
  attempts       Int         @default(0)
  nextAttemptAt  DateTime?   @map("next_attempt_at")
  lastOutcome    CallOutcome? @map("last_outcome")
  skipped        Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  calls    Call[]

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_contacts")
}

model Call {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  channelId         String       @map("channel_id")
  contactId         String?      @map("contact_id")
  campaignId        String?      @map("campaign_id")
  campaignContactId String?      @map("campaign_contact_id")
  agentId           String?      @map("agent_id")
  phone             String
  contactName       String?      @map("contact_name")
  status            CallStatus   @default(QUEUED)
  outcome           CallOutcome?
  engineCallId      String?      @map("engine_call_id")
  source            String       @default("dialer")
  queuedAt          DateTime     @default(now()) @map("queued_at")
  startedAt         DateTime?    @map("started_at")
  answeredAt        DateTime?    @map("answered_at")
  endedAt           DateTime?    @map("ended_at")
  durationMs        Int          @default(0) @map("duration_ms")
  failureReason     String?      @map("failure_reason")
  notes             String?
  recordingPath     String?      @map("recording_path")
  transcript        Json?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         WhatsAppChannel  @relation(fields: [channelId], references: [id])
  contact         Contact?         @relation(fields: [contactId], references: [id])
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  campaignContact CampaignContact? @relation(fields: [campaignContactId], references: [id])
  agent           User?            @relation("CallAgent", fields: [agentId], references: [id])
  attempts        CallAttempt[]

  @@index([organizationId])
  @@index([channelId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([agentId])
  @@map("calls")
}

model CallAttempt {
  id         String       @id @default(uuid())
  callId     String       @map("call_id")
  attemptNo  Int          @map("attempt_no")
  status     CallStatus
  outcome    CallOutcome?
  startedAt  DateTime     @default(now()) @map("started_at")
  endedAt    DateTime?    @map("ended_at")
  durationMs Int          @default(0) @map("duration_ms")
  reason     String?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_attempts")
}

model Recording {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  filePath       String   @map("file_path")
  mimeType       String   @map("mime_type")
  durationMs     Int      @default(0) @map("duration_ms")
  byteSize       Int      @default(0) @map("byte_size")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("recordings")
}

model VoiceTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  body           String
  language       String   @default("hi-IN")
  speaker        String   @default("shubh")
  pace           Float    @default(1.0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("voice_templates")
}

model MessageTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  kind           String   @default("TEXT")
  body           String
  header         String?
  footer         String?
  mediaPath      String?  @map("media_path")
  mediaMime      String?  @map("media_mime")
  buttons        Json?
  listButton     String?  @map("list_button")
  sections       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  autoReplyRules AutoReplyRule[]

  @@index([organizationId])
  @@map("message_templates")
}

model KnowledgeBase {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    KnowledgeBaseDocument[]
  aiConfigs    AiConfig[]

  @@index([organizationId])
  @@map("knowledge_bases")
}

model KnowledgeBaseDocument {
  id              String   @id @default(uuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  title           String
  content         String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@map("knowledge_base_documents")
}

model AiConfig {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  knowledgeBaseId String?  @map("knowledge_base_id")
  name            String
  provider        String   @default("sarvam")
  model           String   @default("sarvam-105b-conversations")
  voice           String?  @default("shubh")
  language        String   @default("hi-IN")
  systemPrompt    String   @map("system_prompt")
  greeting        String?
  objective       String?
  questions       String?
  disallowed      String?
  temperature     Float    @default(0.4)
  maxTokens       Int      @default(400) @map("max_tokens")
  appointmentMessage String? @map("appointment_message")
  /// Soft/hard call length for AI voice (seconds).
  maxCallDurationSec Int     @default(120) @map("max_call_duration_sec")
  /// Seconds before max when the agent should politely wrap up.
  wrapUpSec          Int     @default(25) @map("wrap_up_sec")
  /// related_only | always | never
  memoryRecallMode   String  @default("related_only") @map("memory_recall_mode")
  /// Intent playbook: [{ intent, examples, reply, action }]
  intentPlaybook     Json?   @map("intent_playbook")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase    KnowledgeBase?     @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  campaigns        Campaign[]
  appointmentSlots AppointmentSlot[]
  appointments     Appointment[]
  incomingAnswers  IncomingAnswerConfig[]
  visits           Visit[]

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@map("ai_configs")
}

/// Org-wide memory keyed by phone — shared across all AI agents in the org.
model ContactMemory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  /// Digits-only E.164-ish key (no +).
  phone          String
  summary        String?
  /// Short fact list, e.g. ["Prefers Hindi", "Interested in Plan A"]
  facts          Json?
  lastIntent     String?  @map("last_intent")
  lastOutcome    String?  @map("last_outcome")
  callCount      Int      @default(0) @map("call_count")
  lastCallAt     DateTime? @map("last_call_at")
  lastCallId     String?  @map("last_call_id")
  /// When true, AI will not load or update memory for this number.
  optOut         Boolean  @default(false) @map("opt_out")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([phone])
  @@index([updatedAt])
  @@map("contact_memories")
}

/// Matched playbook intents for analytics.
model IntentEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  aiConfigId     String?  @map("ai_config_id")
  callId         String?  @map("call_id")
  phone          String?
  intent         String
  action         String?
  utterance      String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, intent])
  @@index([aiConfigId])
  @@map("intent_events")
}

model IncomingAnswerConfig {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  channelId      String   @unique @map("channel_id")
  enabled        Boolean  @default(false)
  aiConfigId     String?  @map("ai_config_id")
  sendMessage    Boolean  @default(false) @map("send_message")
  messageBody    String?  @map("message_body")
  messageWhen    String   @default("answered") @map("message_when")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  aiConfig     AiConfig?      @relation(fields: [aiConfigId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("incoming_answer_configs")
}

model AppointmentSlot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  aiConfigId     String   @map("ai_config_id")
  weekday        Int
  startMinute    Int      @map("start_minute")
  endMinute      Int      @map("end_minute")
  durationMin    Int      @default(30) @map("duration_min")
  timezone       String   @default("Asia/Kolkata")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiConfig     AiConfig      @relation(fields: [aiConfigId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId])
  @@index([aiConfigId])
  @@map("appointment_slots")
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  aiConfigId     String            @map("ai_config_id")
  slotId         String?           @map("slot_id")
  channelId      String            @map("channel_id")
  contactId      String?           @map("contact_id")
  callId         String?           @map("call_id")
  phone          String
  contactName    String?           @map("contact_name")
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  status         AppointmentStatus @default(BOOKED)
  notes          String?
  reminderSentAt DateTime?         @map("reminder_sent_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiConfig     AiConfig           @relation(fields: [aiConfigId], references: [id], onDelete: Cascade)
  slot         AppointmentSlot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)
  channel      WhatsAppChannel    @relation(fields: [channelId], references: [id])
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([aiConfigId])
  @@index([phone])
  @@index([startsAt])
  @@index([status])
  @@map("appointments")
}

model Message {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  channelId      String        @map("channel_id")
  contactId      String?       @map("contact_id")
  campaignId     String?       @map("campaign_id")
  phone          String
  body           String
  status         MessageStatus @default(QUEUED)
  provider       String        @default("WEB")
  externalId     String?       @map("external_id")
  error          String?
  sentAt         DateTime?     @map("sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      WhatsAppChannel @relation(fields: [channelId], references: [id])
  contact      Contact?        @relation(fields: [contactId], references: [id])
  campaign     Campaign?       @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([channelId])
  @@index([status])
  @@index([createdAt])
  @@map("messages")
}

model AutoReplyRule {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  campaignId      String?          @map("campaign_id")
  name            String
  trigger         AutoReplyTrigger
  body            String
  imagePath       String?          @map("image_path")
  imageMime       String?          @map("image_mime")
  delaySeconds    Int              @default(3) @map("delay_seconds")
  cooldownMinutes Int              @default(1440) @map("cooldown_minutes")
  showTyping      Boolean          @default(true) @map("show_typing")
  typingSeconds   Int              @default(2) @map("typing_seconds")
  enabled            Boolean          @default(true)
  messageTemplateId  String?          @map("message_template_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messageTemplate MessageTemplate? @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  sends           AutoReplySend[]

  @@index([organizationId, enabled])
  @@index([organizationId, trigger])
  @@index([campaignId])
  @@index([messageTemplateId])
  @@map("auto_reply_rules")
}

model AutoReplySend {
  id        String    @id @default(uuid())
  ruleId    String    @map("rule_id")
  callId    String    @map("call_id")
  phone     String
  status    String    @default("QUEUED")
  error     String?
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  rule AutoReplyRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, callId])
  @@index([ruleId, phone, createdAt])
  @@map("auto_reply_sends")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  prefix         String
  keyHash        String    @map("key_hash")
  scopes         String[]  @default(["calls:write", "messages:write", "channels:read"])
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([prefix])
  @@map("api_keys")
}

model Webhook {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  url            String
  secret         String
  events         String[]
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String    @map("webhook_id")
  event        String
  payload      Json
  statusCode   Int?      @map("status_code")
  success      Boolean   @default(false)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  nextRetryAt  DateTime? @map("next_retry_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([success, nextRetryAt])
  @@map("webhook_deliveries")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  key            String
  value          Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("settings")
}

model CallbackTask {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  callId         String?   @map("call_id")
  contactName    String?   @map("contact_name")
  phone          String
  reason         String
  assignedToId   String?   @map("assigned_to_id")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("callback_tasks")
}

model Visit {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  channelId      String   @map("channel_id")
  name           String
  publicKey      String   @unique @map("public_key")
  targetPhone    String   @map("target_phone")
  buttonLabel    String   @default("Chat with us") @map("button_label")
  greeting       String   @default("Talk to us on WhatsApp")
  purposes       String[] @default(["Sales", "Support", "Partnership", "Other"])
  enabled        Boolean  @default(true)
  chatEnabled    Boolean  @default(true) @map("chat_enabled")
  callEnabled    Boolean  @default(true) @map("call_enabled")
  aiEnabled      Boolean  @default(false) @map("ai_enabled")
  aiConfigId     String?  @map("ai_config_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel       WhatsAppChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  aiConfig      AiConfig?            @relation(fields: [aiConfigId], references: [id], onDelete: SetNull)
  leads         VisitLead[]
  departments   VisitDepartment[]
  sessions      VisitSession[]
  pageViews     VisitPageView[]
  conversations VisitConversation[]

  @@index([organizationId])
  @@index([channelId])
  @@index([aiConfigId])
  @@map("visits")
}

model VisitDepartment {
  id             String   @id @default(uuid())
  visitId        String   @map("visit_id")
  organizationId String   @map("organization_id")
  channelId      String   @map("channel_id")
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  visit         Visit                @relation(fields: [visitId], references: [id], onDelete: Cascade)
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel       WhatsAppChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sessions      VisitSession[]
  conversations VisitConversation[]

  @@index([visitId])
  @@index([organizationId])
  @@index([channelId])
  @@map("visit_departments")
}

model VisitSession {
  id             String   @id @default(uuid())
  visitId        String   @map("visit_id")
  organizationId String   @map("organization_id")
  sessionKey     String   @map("session_key")
  departmentId   String?  @map("department_id")
  name           String?
  phone          String?
  email          String?
  currentUrl     String   @default("") @map("current_url")
  currentTitle   String   @default("") @map("current_title")
  referrer       String   @default("")
  userAgent      String   @default("") @map("user_agent")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  visit         Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    VisitDepartment?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  pageViews     VisitPageView[]
  conversations VisitConversation[]

  @@unique([visitId, sessionKey])
  @@index([visitId, lastSeenAt])
  @@index([organizationId])
  @@map("visit_sessions")
}

model VisitPageView {
  id             String   @id @default(uuid())
  visitId        String   @map("visit_id")
  sessionId      String   @map("session_id")
  organizationId String   @map("organization_id")
  url            String
  title          String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  session      VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
  @@index([sessionId])
  @@map("visit_page_views")
}

model VisitConversation {
  id             String   @id @default(uuid())
  visitId        String   @map("visit_id")
  organizationId String   @map("organization_id")
  sessionId      String   @map("session_id")
  departmentId   String   @map("department_id")
  channelId      String   @map("channel_id")
  phone          String
  name           String   @default("")
  status         String   @default("open")
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")

  visit        Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      VisitSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  department   VisitDepartment   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  channel      WhatsAppChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages     VisitChatMessage[]

  @@index([visitId, lastMessageAt])
  @@index([organizationId])
  @@index([channelId, phone])
  @@index([sessionId])
  @@map("visit_conversations")
}

model VisitChatMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  organizationId String   @map("organization_id")
  sender         String
  body           String
  whatsappId     String?  @map("whatsapp_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation VisitConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@map("visit_chat_messages")
}

model VisitLead {
  id             String   @id @default(uuid())
  visitId        String   @map("visit_id")
  organizationId String   @map("organization_id")
  name           String
  phone          String
  email          String
  purpose        String
  messageId      String?  @map("message_id")
  callId         String?  @map("call_id")
  status         String   @default("submitted")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("visit_leads")
}

model CsvImport {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  fileName       String   @map("file_name")
  totalRows      Int      @default(0) @map("total_rows")
  validRows      Int      @default(0) @map("valid_rows")
  invalidRows    Int      @default(0) @map("invalid_rows")
  duplicateRows  Int      @default(0) @map("duplicate_rows")
  status         String   @default("preview")
  errorReport    Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("csv_imports")
}
