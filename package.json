{
  "name": "wacalls",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted WhatsApp Web calling and sequential dialer",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" --filter \"./services/**\" build",
    "dev": "pnpm --parallel --filter @wacalls/api --filter @wacalls/web --filter @wacalls/whatsapp --filter @wacalls/worker dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --filter \"./packages/**\" --filter \"./apps/api\" --filter \"./services/**\" test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @wacalls/database generate",
    "db:migrate": "pnpm --filter @wacalls/database migrate",
    "db:seed": "pnpm --filter @wacalls/database seed",
    "format": "prettier --write ."
  }
}
