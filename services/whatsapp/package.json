{
  "name": "@wacalls/whatsapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@wacalls/audio-engine": "workspace:*",
    "@wacalls/calling-engine": "workspace:*",
    "@wacalls/database": "workspace:*",
    "@whiskeysockets/baileys": "^7.0.0-rc.11",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "baileys-caller": "github:SheIITear/baileys-caller"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
