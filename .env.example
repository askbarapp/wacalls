APP_NAME=WaCalls
APP_ENV=production
APP_URL=https://wacalls.example.com
LOG_LEVEL=info

DOMAIN=
API_DOMAIN=

# Public URLs used by the Next.js browser bundle
NEXT_PUBLIC_API_URL=https://wacalls.example.com
NEXT_PUBLIC_WS_URL=wss://wacalls.example.com/ws

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wacalls
POSTGRES_USER=wacalls
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://wacalls:change-me@postgres:5432/wacalls?schema=public

REDIS_URL=redis://redis:6379

JWT_SECRET=generate-a-64-char-secret
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=30d

ENCRYPTION_KEY=generate-a-64-char-hex-key
INTERNAL_TOKEN=generate-a-shared-internal-token

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WaCalls <noreply@example.com>

AI_PROVIDER=sarvam
AI_API_KEY=
AI_MODEL=sarvam-105b-conversations
AI_STT_PROVIDER=sarvam
AI_TTS_PROVIDER=sarvam
# Sarvam AI (TTS + STT + conversational agent). Also configurable per workspace in AI calling.
SARVAM_API_KEY=

# selfhosted | mock | wavoip
# mock is refused unless APP_ENV=development
CALLING_ENGINE=selfhosted

# Optional git install inside the WhatsApp image
BAILEYS_CALLER_ENABLED=true

WEB_PORT=3000
API_PORT=3001
WHATSAPP_PORT=4010
METRICS_PORT=9090

# Public IPv4 of this VPS (ICE/NAT). Installer fills this automatically.
PUBLIC_IP=

# WhatsApp call ICE/RTP UDP range (must match docker-compose ports + UFW)
ICE_UDP_PORT_MIN=10000
ICE_UDP_PORT_MAX=10031

SESSION_DIR=/data/sessions
RECORDINGS_DIR=/data/recordings

CORS_ORIGINS=https://wacalls.example.com

BACKUP_RETENTION_DAYS=7
